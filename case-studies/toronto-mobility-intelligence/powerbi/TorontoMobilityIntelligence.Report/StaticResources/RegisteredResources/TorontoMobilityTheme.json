{
  "name": "Toronto Mobility Intelligence",
  "dataColors": [
    "#3B5B7D",
    "#5B7FA6",
    "#7FA3C7",
    "#A3C7E0",
    "#8A8F98",
    "#C7CDD6",
    "#D97706",
    "#B91C1C"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#3B5B7D",
  "good": "#3B5B7D",
  "neutral": "#8A8F98",
  "bad": "#B91C1C",
  "maximum": "#B91C1C",
  "center": "#D97706",
  "minimum": "#E5EDF5",
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E5E9" } }, "radius": 4 }],
        "outspacePane": [{ "backgroundColor": { "solid": { "color": "#FFFFFF" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#1F2937" } }, "fontSize": 28 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#5B7280" } }, "fontSize": 11 }]
      }
    }
  },
  "textClasses": {
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "callout": { "fontSize": 28, "color": "#1F2937" }
  }
}

	lineageTag: 3cff1d92-85c0-47e1-b613-903973bc9a2c

	column px
		isKey
		dataType: int64
		formatString: 0
		sourceColumn: px
		summarizeBy: none
		lineageTag: 059ead5c-0582-4c4d-93ed-266a58fe008d

	column main_street

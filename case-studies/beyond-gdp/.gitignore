# Raw and processed data are regenerated by R/01_ingestion.R - R/03_joining.R
# directly from official sources -- not committed, per this portfolio's
# data-hygiene convention. Run scripts/run_all.R to reproduce them locally.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated model objects -- regenerated by R/05_modeling.R - R/07_robustness.R
outputs/models/*
!outputs/models/.gitkeep

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# renv -- only renv.lock + the activation scaffolding are committed,
# never the installed package library itself
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/

# macOS
.DS_Store

*.tmp
*.log
